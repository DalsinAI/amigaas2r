; $VER: Install-AS2R standalone-rc1 (5.11.2026)
; The Amiga Installer script for AS2R: Another Sonic 2 Remake, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the AS2R drawer where the archive was unpacked.

(set @app-name "AS2R: Another Sonic 2 Remake")
(set #version "standalone-rc1")
(set #drawer "AS2R")
(set #program "StartGame")
(set #space 468750)  ; KB

(onerror
    (message (cat "AS2R: Another Sonic 2 Remake was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-AS2R again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "AS2R: Another Sonic 2 Remake needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "AS2R: Another Sonic 2 Remake needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "AS2R: Another Sonic 2 Remake needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The AS2R drawer is not beside Install-AS2R. Unpack the whole archive, then run Install-AS2R from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The AS2R drawer has no StartGame in it. Unpack the whole archive again."))

(welcome "This installs AS2R: Another Sonic 2 Remake standalone-rc1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the AS2R drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called AS2R in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": AS2R: Another Sonic 2 Remake needs 480 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/GL.module" (noreq)) 1))
    (abort "AS2R: Another Sonic 2 Remake needs GFOpenGPU's GL.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-AS2R again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "AS2R: Another Sonic 2 Remake needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-AS2R again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1)
    (copylib
        (prompt "Copying GL.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/GL.module")
        (dest "LIBS:GFOpenGPU")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copylib
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/SDL2.module")
        (dest "LIBS:GFOpenGPU")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "Game") (noreq))
    (set #kept (if (= #kept "") "Game" (cat #kept "|" "Game"))))
(if (exists (tackon #dest "game.zip") (noreq))
    (set #kept (if (= #kept "") "game.zip" (cat #kept "|" "game.zip"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying AS2R: Another Sonic 2 Remake")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating AS2R: Another Sonic 2 Remake. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "AS2R.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "AS2R.info")))


; ---------------------------------------------------------------- the game's own files
; AS2R: Another Sonic 2 Remake's own files are not in this archive: the player gives the Installer
; the archive or the folder they downloaded themselves, and the game drawer is
; built from it here, on this Amiga.
(set #root "Another Sonic 2 Remake")
(set #archive "Another Sonic 2 Remake Android Compatible.zip")
(set #archive-size 121434129)
(set #game (tackon #dest "Game"))
(set #gamezip (tackon #dest "game.zip"))
(set #have (or (= (exists (tackon #game "languages") (noreq)) 2) (= (exists #gamezip (noreq)) 1)))
(message "AS2R: Another Sonic 2 Remake's own files are not part of this archive and are not given out with it. Download the game yourself from its page:\n\nhttps://sonicfangameshq.com/forums/showcase/as2r-another-sonic-2-remake-sage-22-demo.1389/\n\nThe file there is called Another Sonic 2 Remake Android Compatible.zip (121434129 bytes; SHA-256 dd79b04d12164ff5572a0abed1f38930e3d102d498d9113f82aed00a3a9eece2).")
(set #how
    (askchoice
        (prompt "Where are AS2R: Another Sonic 2 Remake's own files, from Another Sonic 2 Remake Android Compatible.zip?")
        (help "The Installer copies the game's files into the Game drawer inside AS2R, beside the OpenSurge engine that comes with this archive. The archive is unpacked with SYS:Utilities/GFOpenCompress. Without it, unpack the archive with any unzip tool and choose the folder instead. prepare-amiga-port.sh (in the port's repository) makes a game.zip on another computer from the same download. Keep: leaves what an earlier run installed.")
        (choices "The archive I downloaded (Another Sonic 2 Remake Android Compatible.zip)" "The folder I unpacked it into (called Another Sonic 2 Remake)" "A game.zip made by prepare-amiga-port.sh" "Keep the game files already installed")
        (default (if #have 3 0))))
(if (and (= #how 3) (not #have))
    (abort (cat "No game files are installed yet, so there is nothing to keep. Run Install-AS2R again and choose your download. The engine is installed in " #dest ".")))
(set #src "")
(if (= #how 0)
    (
        (set #arc
            (askfile
                (prompt "Choose Another Sonic 2 Remake Android Compatible.zip, as you downloaded it.")
                (help @askfile-help)
                (default "RAM:")))
        (if (<> (exists #arc (noreq)) 1)
            (abort (cat "There is no file " #arc ".")))
        (if (<> (getsize #arc) #archive-size)
            (abort (cat #arc " is " (getsize #arc) " bytes, not the 121434129 of Another Sonic 2 Remake Android Compatible.zip. Download it again from https://sonicfangameshq.com/forums/showcase/as2r-another-sonic-2-remake-sage-22-demo.1389/")))
        (if (<> (exists "SYS:Utilities/GFOpenCompress" (noreq)) 1)
            (abort "SYS:Utilities/GFOpenCompress, which unpacks the archive, is not on this Amiga. Unpack Another Sonic 2 Remake Android Compatible.zip with an unzip tool, then run Install-AS2R again and choose the Another Sonic 2 Remake folder."))
        (set #unpack (tackon #dest "Unpack"))
        (if (= (exists #unpack (noreq)) 2)
            (delete #unpack (all) (optional "force")))
        (makedir #unpack)
        (working "Unpacking Another Sonic 2 Remake Android Compatible.zip. This takes a few minutes.")
        (run (cat "SYS:Utilities/GFOpenCompress x \"" #arc "\" \"" #unpack "\" >NIL:"))
        (set #src (tackon #unpack #root))
    )
)
(if (= #how 1)
    (
        (set #src
            (askdir
                (prompt "Choose the folder called Another Sonic 2 Remake, unpacked from Another Sonic 2 Remake Android Compatible.zip.")
                (help @askdir-help)
                (default "RAM:")))
        (if (and (<> (fileonly #src) #root) (= (exists (tackon #src #root) (noreq)) 2))
            (set #src (tackon #src #root)))
        (if (<> (fileonly #src) #root)
            (abort (cat #src " is not the Another Sonic 2 Remake folder. Choose the folder that unpacking Another Sonic 2 Remake Android Compatible.zip made.")))
    )
)
(if (<> #src "")
    (
        (if (<> (exists (tackon #src "scripts/ui/menubuttonlist.ss") (noreq)) 1)
            (abort (cat #src " has no scripts/ui/menubuttonlist.ss. It is not a complete copy of Another Sonic 2 Remake Android Compatible.zip; unpack it again.")))
        (if (<> (getsize (tackon #src "scripts/ui/menubuttonlist.ss")) 6940)
            (abort (cat "scripts/ui/menubuttonlist.ss in " #src " is not the one in Another Sonic 2 Remake Android Compatible.zip (6940 bytes). Download the game again from https://sonicfangameshq.com/forums/showcase/as2r-another-sonic-2-remake-sage-22-demo.1389/")))
        (if (<> (exists (tackon #src "levels/Ice_Cap_test.lev") (noreq)) 1)
            (abort (cat #src " has no levels/Ice_Cap_test.lev. It is not a complete copy of Another Sonic 2 Remake Android Compatible.zip; unpack it again.")))
        (if (<> (getsize (tackon #src "levels/Ice_Cap_test.lev")) 24446)
            (abort (cat "levels/Ice_Cap_test.lev in " #src " is not the one in Another Sonic 2 Remake Android Compatible.zip (24446 bytes). Download the game again from https://sonicfangameshq.com/forums/showcase/as2r-another-sonic-2-remake-sage-22-demo.1389/")))
        (if (<> (exists (tackon #src "musics/parkav.ogg") (noreq)) 1)
            (abort (cat #src " has no musics/parkav.ogg. It is not a complete copy of Another Sonic 2 Remake Android Compatible.zip; unpack it again.")))
        (if (<> (getsize (tackon #src "musics/parkav.ogg")) 3435552)
            (abort (cat "musics/parkav.ogg in " #src " is not the one in Another Sonic 2 Remake Android Compatible.zip (3435552 bytes). Download the game again from https://sonicfangameshq.com/forums/showcase/as2r-another-sonic-2-remake-sage-22-demo.1389/")))
        (if (= (exists #gamezip (noreq)) 1)
            (delete #gamezip (optional "force")))
        (if (= (exists #game (noreq)) 2)
            (delete #game (all) (optional "force")))
        (copyfiles
            (prompt "Copying AS2R: Another Sonic 2 Remake's files into the Game drawer")
            (help @copyfiles-help)
            (source #src)
            (dest #game)
            (pattern "~(#?.exe|#?.dll|src|screenshots|logfile.txt|allegro.log|surge.prefs|CMakeLists.txt|CHANGES.md|CONTRIBUTING.md|README.md)")
            (optional "force"))
        ; the game predates surge.cfg: add the port's (its title and screen size)
        (if (<> (exists (tackon #game "surge.cfg") (noreq)) 1)
            (copyfiles
                (help @copyfiles-help)
                (source (tackon #dest "Tools/surge.cfg"))
                (dest #game)
                (optional "force")))
        ; OpenSurge 0.6.1 asks for MenuButtonList to be declared an entity
        (if (<> @pretend 1)
            (
                (run "SYS:System/RexxMast >NIL:")
                (run "SYS:Rexxc/WaitForPort REXX")
                ; RX takes a quoted first word as a program's text, not its name: so
                ; the script is run from T:, whose name has no spaces in it
                (copyfiles (source (tackon #dest "Tools/PatchMenu.rexx")) (dest "T:") (optional "force"))
                (run (cat "SYS:Rexxc/RX T:PatchMenu.rexx \"" (tackon #game "scripts/ui/menubuttonlist.ss") "\""))
                (delete "T:PatchMenu.rexx" (optional "force"))
            )
        )
        (if (= (exists (tackon #dest "Unpack") (noreq)) 2)
            (delete (tackon #dest "Unpack") (all) (optional "force")))
    )
)
(if (= #how 2)
    (
        (set #zip
            (askfile
                (prompt "Choose the game.zip that prepare-amiga-port.sh made from Another Sonic 2 Remake Android Compatible.zip.")
                (help @askfile-help)
                (default "RAM:")))
        (if (<> (exists #zip (noreq)) 1)
            (abort (cat "There is no file " #zip ".")))
        (if (= (exists #game (noreq)) 2)
            (delete #game (all) (optional "force")))
        (copyfiles
            (help @copyfiles-help)
            (source #zip)
            (dest #dest)
            (newname "game.zip")
            (optional "force"))
    )
)

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. AS2R: Another Sonic 2 Remake would have gone in " #dest "."))
    (message (cat "AS2R: Another Sonic 2 Remake standalone-rc1 is installed in " #dest "."
                  "\n\nTo start it, open the AS2R drawer and double-click the StartGame icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
